FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver 	 PCG;
        preconditioner  DIC;
        tolerance       1e-9;
        relTol          0.01;
        maxIter         1000;
    }

    "(U|k|omega|e)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-15;
        relTol          0;
    }

}

SIMPLE
{
    residualControl
    {
        "(U|k|omega|p)" 1e-6;
    }

    nNonOrthogonalCorrectors 0;
    consistent          yes;
}




relaxationFactors
{
    fields
    {
        p               0.7;
    }
    equations
    {
        U               0.6;
        "(k|omega)"     0.5;
    }
}


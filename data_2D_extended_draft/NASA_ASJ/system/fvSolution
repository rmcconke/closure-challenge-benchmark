FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-8;
        relTol          0.01;
    }

    pFinal
    {
        $p;
        relTol          0.001;
    }

    "(rho|U|k|omega|e)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-10;
        relTol          0.1;
    }

    "(rho|U|k|omega|e)Final"
    {
        $U;
        relTol          0;
    }
}

PIMPLE
{
    outerCorrectorResidualControl
    {
        p                       {tolerance 1e-4; relTol 0;};
        Uy                      {tolerance 1e-3; relTol 0;};
        "(Ux|Uz|k|omega|e)"     {tolerance 1e-5; relTol 0;};
    }
    nCorrectors                 1;
    nNonOrthogonalCorrectors    0;
    nOuterCorrectors            5;
    consistent                  yes;
}


relaxationFactors
{
    fields
    {
        p               0.9;
        rho             0.9;
        T		        0.9;
    }
    equations
    {
        U               0.9;
        e               0.9;
        "(k|epsilon|omega)" 0.9;
    }
}


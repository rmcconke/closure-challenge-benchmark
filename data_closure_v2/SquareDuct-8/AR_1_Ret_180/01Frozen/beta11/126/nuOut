FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "126";
    object      nuOut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 1.5e-05;

boundaryField
{
    inflow
    {
        type            cyclic;
    }
    outflow
    {
        type            cyclic;
    }
    wallTop
    {
        type            calculated;
        value           uniform 1.5e-05;
    }
    wallSide
    {
        type            calculated;
        value           uniform 1.5e-05;
    }
    symmetryBottom
    {
        type            symmetry;
    }
    symmetrySide
    {
        type            symmetry;
    }
}



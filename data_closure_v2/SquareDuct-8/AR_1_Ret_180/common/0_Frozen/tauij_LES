FoamFile
{
    version     2.0;
    format      ascii;
    class       volSymmTensorField;
    object      tauij_LES;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [0 2 -2 0 0 0 0];

#include "../../interpolateDNS/interpolatedFields/tauij_LES"

internalField           $tauij_LES;

boundaryField
{
    "(wallTop|wallSide)"
    {
        type            fixedValue;
        value           uniform (0 0 0 0 0 0);
    }

    inflow
    {
        type            cyclic;
    }
    outflow
    {
        type            cyclic;
    }

    "(symmetryBottom|symmetrySide)"
    {
        type            symmetry;
    }

}


FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{

    p
    {
        solver          GAMG;
        tolerance       1e-8;
        relTol          0;
        smoother        DICGaussSeidel;
    }
    
    omega
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-15;
        relTol          0.1;

    }

}

SIMPLE
{
    nNonOrthogonalCorrectors 30;

    residualControl
    {
        omega           2e-7;
    }
    consistent          no;

}

relaxationFactors
{
    equations
    {
        omega           0.5;
    }
}


